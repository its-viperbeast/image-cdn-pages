---
interface Props {
	title: string;
	message: string;
}

const { title, message } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style>
			:root {
				color-scheme: dark;
			}
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				background: #0b0d10;
				color: #e6e8eb;
				font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
				text-align: center;
			}
			main {
				padding: 2rem;
			}
			h1 {
				margin: 0 0 0.5rem;
				font-size: 1.5rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			p {
				margin: 0;
				color: #9aa3ad;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>{title}</h1>
			<p>{message}</p>
		</main>
	</body>
</html>
